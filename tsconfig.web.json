{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "rootDir": "src/util",
    "outDir": "src/web/ui/vendor",
    "types": []
  },
  "files": [
    "src/util/markdown.ts",
    "src/util/highlight.ts",
    "src/util/diff.ts",
    "src/util/repeat.ts"
  ]
}
